#@on-error omit
plugin_register sharding
#@on-error default

table_create Entries_20260901 TABLE_PAT_KEY ShortText
column_create Entries_20260901 timestamp COLUMN_SCALAR Time
column_create Entries_20260901 content COLUMN_SCALAR Text
table_create Terms_20260901 TABLE_PAT_KEY|KEY_NORMALIZE ShortText --default_tokenizer TokenBigram
column_create Terms_20260901 entries_content_index COLUMN_INDEX|WITH_POSITION Entries_20260901 content

table_create Entries_20260902 TABLE_PAT_KEY ShortText
column_create Entries_20260902 timestamp COLUMN_SCALAR Time
column_create Entries_20260902 content COLUMN_SCALAR Text
table_create Terms_20260902 TABLE_PAT_KEY|KEY_NORMALIZE ShortText --default_tokenizer TokenBigram
column_create Terms_20260902 entries_content_index COLUMN_INDEX|WITH_POSITION Entries_20260902 content

load --table Entries_20260901
[
{"timestamp": "2026/09/01 00:00:00", "_key": "The first post!", "content": "Welcome! This is my first post!"},
{"timestamp": "2026/09/01 01:00:00", "_key": "Mroonga", "content": "I also started to use mroonga. It's also very fast! Really fast!"},
{"timestamp": "2026/09/01 02:00:00", "_key": "Good-bye Tritonn", "content": "I also migrated all Tritonn system!"}
]

load --table Entries_20260902
[
{"timestamp": "2026/09/02 00:00:00", "_key": "Groonga", "content": "I started to use groonga. It's very fast!"},
{"timestamp": "2026/09/02 01:00:00", "_key": "Good-bye Senna", "content": "I migrated all Senna system!"}
]

logical_select Entries \
  --shard_key timestamp \
  --output_columns '_key,content,_score' \
  --match_columns content --query '-fast' \
  --query_flags ALLOW_LEADING_NOT \
  --sort_keys _key
