#@on-error omit
plugin_register sharding
#@on-error default

table_create Logs_20170315 TABLE_NO_KEY
column_create Logs_20170315 timestamp COLUMN_SCALAR Time
column_create Logs_20170315 price COLUMN_SCALAR UInt32

table_create Logs_20170316 TABLE_NO_KEY
column_create Logs_20170316 timestamp COLUMN_SCALAR Time
column_create Logs_20170316 price COLUMN_SCALAR UInt32

table_create Logs_20170317 TABLE_NO_KEY
column_create Logs_20170317 timestamp COLUMN_SCALAR Time
column_create Logs_20170317 price COLUMN_SCALAR UInt32

load --table Logs_20170315
[
{"timestamp": "2017/03/15 00:00:00", "price": 1000},
{"timestamp": "2017/03/15 01:00:00", "price":  900}
]

load --table Logs_20170316
[
{"timestamp": "2017/03/16 10:00:00", "price":  520},
{"timestamp": "2017/03/16 11:00:00", "price":  510}
]

load --table Logs_20170317
[
{"timestamp": "2017/03/17 20:00:00", "price":  500},
{"timestamp": "2017/03/17 20:00:00", "price":  300}
]

#@collect-query-log true
#@sort-query-log-operations shard
logical_select Logs \
  --shard_key timestamp \
  --sort_keys -timestamp \
  --limit 3 \
  --columns[output_id].stage output \
  --columns[output_id].type UInt32 \
  --columns[output_id].flags COLUMN_SCALAR \
  --columns[output_id].value '_id' \
  --output_columns _id,output_id,price
#@sort-query-log-operations
#@collect-query-log false
