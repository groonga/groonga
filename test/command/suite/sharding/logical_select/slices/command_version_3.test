#@on-error omit
plugin_register sharding
#@on-error default
plugin_register functions/time

table_create Tags TABLE_PAT_KEY ShortText

table_create Memos_20260901 TABLE_HASH_KEY ShortText
column_create Memos_20260901 timestamp COLUMN_SCALAR Time
column_create Memos_20260901 tag COLUMN_SCALAR Tags

table_create Memos_20260902 TABLE_HASH_KEY ShortText
column_create Memos_20260902 timestamp COLUMN_SCALAR Time
column_create Memos_20260902 tag COLUMN_SCALAR Tags

load --table Memos_20260901
[
{"_key": "Groonga is fast!", "timestamp": "2026-09-01 12:00:00", "tag": "Groonga"},
{"_key": "Mroonga is fast!", "timestamp": "2026-09-01 12:00:01", "tag": "Mroonga"}
]

load --table Memos_20260902
[
{"_key": "Groonga sticker!", "timestamp": "2026-09-02 12:00:02", "tag": "Groonga"},
{"_key": "Rroonga is fast!", "timestamp": "2026-09-02 12:00:03", "tag": "Rroonga"}
]

logical_select Memos \
  --shard_key timestamp \
  --slices[groonga].filter 'tag == "Groonga"' \
  --slices[groonga].sort_keys 'timestamp' \
  --slices[groonga].output_columns '_key, timestamp' \
  --slices[groonga].columns[timestamp_day].stage filtered \
  --slices[groonga].columns[timestamp_day].type Time \
  --slices[groonga].columns[timestamp_day].value 'time_classify_day(timestamp)' \
  --slices[groonga].drilldowns[day].keys 'timestamp_day' \
  --command_version 3
