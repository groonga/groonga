#@on-error omit
plugin_register sharding
#@on-error default

table_create Logs_host1 TABLE_NO_KEY
column_create Logs_host1 timestamp COLUMN_SCALAR Time
column_create Logs_host1 memo COLUMN_SCALAR ShortText

table_create Logs_host2 TABLE_NO_KEY
column_create Logs_host2 timestamp COLUMN_SCALAR Time
column_create Logs_host2 memo COLUMN_SCALAR ShortText

load --table Logs_host1
[
{"timestamp": "2026/09/01 00:00:00", "memo": "aaa"},
{"timestamp": "2026/09/05 01:00:00", "memo": "zzz"}
]

load --table Logs_host2
[
{"timestamp": "2026/09/03 10:00:00", "memo": "bbb"},
{"timestamp": "2026/09/02 11:00:00", "memo": "yyy"}
]

logical_select \
  --shard_key timestamp \
  --shard[1].table Logs_host2 \
  --shard[2].table Logs_host1 \
  --sort_keys timestamp \
  --output_columns memo,timestamp
