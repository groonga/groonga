#@on-error omit
plugin_register sharding
#@on-error default

table_create Logs_20170315 TABLE_NO_KEY
column_create Logs_20170315 timestamp COLUMN_SCALAR Time
column_create Logs_20170315 memo COLUMN_SCALAR ShortText
column_create Logs_20170315 n_likes COLUMN_SCALAR UInt32

table_create Logs_20170316 TABLE_NO_KEY
column_create Logs_20170316 timestamp COLUMN_SCALAR Time
column_create Logs_20170316 memo COLUMN_SCALAR ShortText
column_create Logs_20170316 n_likes COLUMN_SCALAR UInt32

load --table Logs_20170315
[
{"timestamp": "2017/03/15 00:00:00", "memo": "a1", "n_likes": 1},
{"timestamp": "2017/03/15 01:00:00", "memo": "a2", "n_likes": 1},
{"timestamp": "2017/03/15 02:00:00", "memo": "a3", "n_likes": 1}
]

load --table Logs_20170316
[
{"timestamp": "2017/03/16 10:00:00", "memo": "b1", "n_likes": 1},
{"timestamp": "2017/03/16 11:00:00", "memo": "b2", "n_likes": 1},
{"timestamp": "2017/03/16 12:00:00", "memo": "b3", "n_likes": 1}
]

# All records have the same sort key value.
# Records must not be duplicated nor missing across pages.

logical_select Logs \
  --shard_key timestamp \
  --sort_keys n_likes \
  --output_columns memo \
  --offset 0 \
  --limit 2

logical_select Logs \
  --shard_key timestamp \
  --sort_keys n_likes \
  --output_columns memo \
  --offset 2 \
  --limit 2

logical_select Logs \
  --shard_key timestamp \
  --sort_keys n_likes \
  --output_columns memo \
  --offset 4 \
  --limit 2
