table_create Blog TABLE_NO_KEY
[[0,0.0,0.0],true]
column_create Blog html COLUMN_SCALAR Text
[[0,0.0,0.0],true]
load --table Blog
[
{"html": "<nav>nav</nav><article>Groonga article</article>"},
{"html": "<nav>nav</nav><article>Mroonga article</article>"},
{"html": "<nav>nav</nav><article>Blog article</article>"}
]
[[0,0.0,0.0],3]
table_create Terms TABLE_PAT_KEY ShortText   --default_tokenizer TokenBigram   --normalizers NormalizerNFKC   --extractors 'ExtractorHTML("selector", "article")'
[[0,0.0,0.0],true]
column_create Terms blog_html COLUMN_INDEX|WITH_POSITION Blog html
[[0,0.0,0.0],true]
select Blog   --match_columns html   --query "groonga"   --output_columns html
[
  [
    0,
    0.0,
    0.0
  ],
  [
    [
      [
        1
      ],
      [
        [
          "html",
          "Text"
        ]
      ],
      [
        "<nav>nav</nav><article>Groonga article</article>"
      ]
    ]
  ]
]
select Blog   --match_columns html   --query "nav"   --output_columns html
[[0,0.0,0.0],[[[0],[["html","Text"]]]]]
index_column_diff Terms blog_html
[[0,0.0,0.0],[]]
