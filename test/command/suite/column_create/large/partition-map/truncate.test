#$GRN_JA_N_DATA_SEGMENTS=2

table_create Memos TABLE_HASH_KEY ShortText
column_create Memos content COLUMN_SCALAR|COLUMN_LARGE Text

log_level --level info
#@add-important-log-levels info

load --table Memos
[
{"_key": "Groonga", "content": "Mroonga, PGroonga, and Rroonga"},
{"_key": "Mroonga", "content": "Groonga, PGroonga, and Rroonga"}
]

truncate Memos

#@remove-important-log-levels info
log_level --level notice
