# A posting for "a" in the 2nd record can be stored in a buffer but
# it can't be stored with the embedded posting for "a" in the 1st
# record. It's merged into a chunk directly.
table_create Memos TABLE_NO_KEY
column_create Memos content COLUMN_SCALAR LongText

table_create Terms TABLE_PAT_KEY ShortText --default_tokenizer TokenDelimit
column_create Terms index COLUMN_INDEX|WITH_POSITION Memos content

load --table Memos
[
{"content": "a c"}
]

#@timeout 60
#@disable-logging
#@generate-series 1 1 Memos '{"content" => "a " + ("a " * 41) + ("b " * 142 + "a ") * 131029}'
#@enable-logging
#@timeout default

select Memos \
  --match_columns content \
  --query a \
  --output_columns _id,_score \
  --sort_keys _id
