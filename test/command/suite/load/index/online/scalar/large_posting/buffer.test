# A posting for "a" in the 3rd record is too large to be stored in a
# buffer. It's merged into a chunk directly with postings for "a" in
# the buffer.
table_create Memos TABLE_NO_KEY
column_create Memos content COLUMN_SCALAR LongText

table_create Terms TABLE_PAT_KEY ShortText --default_tokenizer TokenDelimit
column_create Terms index COLUMN_INDEX|WITH_POSITION Memos content

load --table Memos
[
{"content": "a c"},
{"content": "a d"}
]

#@timeout 60
#@disable-logging
#@generate-series 1 1 Memos '{"content" => ("a " + "b " * 142) * 131071}'
#@enable-logging
#@timeout default

load --table Memos
[
{"content": "a e"}
]

select Memos \
  --match_columns content \
  --query a \
  --output_columns _id,_score \
  --sort_keys _id

select Memos \
  --match_columns content \
  --query '"b a"' \
  --output_columns _id,_score \
  --sort_keys _id
